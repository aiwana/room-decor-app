# Copy file nay thanh .env de doi cau hinh (.env da nam trong .gitignore, khong commit).
# Sua .env xong phai chay lai: npx expo start -c
# KHONG dat mat khau / API key bi mat o day: moi bien EXPO_PUBLIC_* deu bi dong goi vao app.

# true = dung du lieu gia (mac dinh), false = goi backend that
EXPO_PUBLIC_USE_MOCK=true

# Dia chi backend (backend/src/server.ts dang chay cong 3000).
# Bo trong dong nay -> app tu dung: Android Emulator = http://10.0.2.2:3000, Web = http://localhost:3000
# Chon 1 dong phu hop roi bo dau # o dau dong:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000        # Android Emulator
# EXPO_PUBLIC_API_URL=http://localhost:3000       # Web tren cung may tinh
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000     # Dien thoai that: thay bang IPv4 cua may tinh (lenh ipconfig)
