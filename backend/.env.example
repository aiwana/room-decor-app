# Copy this file to backend/.env and fill in the values. Never commit .env.
# Spring Boot loads backend/.env through spring.config.import in application.yml.
# Write values without quotes.

# Database on host port 5433: start it with "docker compose up -d" (docker-compose.yml uses these values)
# or use the old room-decor-postgres container. DB_PASSWORD is required by both.
DB_URL=jdbc:postgresql://localhost:5433/roomdecor
DB_USERNAME=roomdecor_app
DB_PASSWORD=

# JWT: at least 32 characters. Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Storage
UPLOAD_DIR=./uploads
STORAGE_BASE_URL=http://localhost:8080/files

# AI: gemini | openai | mock (blank = auto: Gemini if key, then OpenAI, then mock)
AI_PROVIDER=

# OpenAI Vision - leave blank to skip
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (Google AI Studio) - leave blank to use mock scanner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
