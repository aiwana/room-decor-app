# Copy to backend/.env; do not commit real credentials.
PORT=3000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/room_decor
# Generate a unique random value with at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional external URL when deploying behind a reverse proxy.
# PUBLIC_BASE_URL=https://api.example.com

# Uploaded room photos are private and served through expiring signed URLs.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760

# Set true when the managed PostgreSQL provider requires TLS.
PGSSL=false
