# Copy file nay thanh .env (KHONG dua .env len git), roi chay lai: npx expo start -c

# true  = dung du lieu gia trong app, khong can backend (mac dinh)
# false = goi backend Spring Boot that
EXPO_PUBLIC_USE_MOCK=true

# Dia chi backend, CO "/api" o cuoi:
#   Android Emulator : http://10.0.2.2:8080/api
#   Dien thoai that  : http://<IP LAN may tinh>:8080/api  (vd http://192.168.1.10:8080/api)
#   iOS Simulator    : http://localhost:8080/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
