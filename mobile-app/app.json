{
  "expo": {
    "name": "RoomDecor",
    "slug": "roomdecor",
    "version": "1.2.0",
    "scheme": "roomdecor",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.roomdecor.app"
    },
    "android": {
      "package": "com.roomdecor.app",
      "versionCode": 2,
      "backgroundColor": "#1A1A1A",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RoomDecor cần truy cập thư viện ảnh để chọn ảnh căn phòng.",
          "cameraPermission": "RoomDecor cần camera để chụp ảnh căn phòng."
        }
      ],
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c70f1793-d603-482f-bf86-f105467ba2f8"
      }
    }
  }
}
